# ============================================================
# 这是配置模板，复制为 application.properties 后填入自己的信息。
# application.properties 已被 .gitignore 忽略，不会提交到 GitHub。
# ============================================================

# 服务端口（后端运行在8080端口，前端访问这个地址）
server.port=8080

# MySQL数据库连接配置
spring.datasource.url=jdbc:mysql://localhost:3306/bookstore?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=在这里填写你的数据库密码
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
